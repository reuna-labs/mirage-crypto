(library
 (name backend_startup)
 (modules)
 (enabled_if (= %{context_name} solo5))
 (foreign_stubs (language c) (names startup manifest)))
(rule
 (targets manifest.c)
 (deps manifest.json)
 (action (run solo5-elftool gen-manifest manifest.json manifest.c)))
(rule (targets smoke_secp256k1.ml) (deps ../../secp256k1/test/smoke.ml)
 (action (copy %{deps} %{targets})))
(executable
 (name smoke_secp256k1) (modules smoke_secp256k1) (modes native)
 (enabled_if (= %{context_name} solo5))
 (libraries backend_startup mirage-crypto-secp256k1)
 (link_flags :standard -cclib "-z solo5-abi=%{env:MODE=spt}"
   -cclib "-u __solo5_mft1_note"))
