opam-version: "2.0"
synopsis: "Selected native PBKDF2-HMAC kernels for Mirage"
maintainer: "Reuna"
authors: ["Reuna" "Joseph Birr-Pixton" "Nicolas Di Prima" "Vincent Hanquez"]
license: ["ISC" "CC0-1.0" "BSD-2-Clause" "BSD-3-Clause"]
homepage: "https://github.com/reuna-labs/mirage-crypto"
dev-repo: "git+https://github.com/reuna-labs/mirage-crypto.git"
bug-reports: "https://github.com/reuna-labs/mirage-crypto/issues"
depends: [
 "ocaml" {>= "4.13.0"}
 "dune" {>= "2.7"}
 "digestif" {>= "1.4.0"}
]
build: [["dune" "build" "-p" name "-j" jobs]]
run-test: [["dune" "runtest" "-p" name "-j" jobs]]
# Coordinated C headers, including the source-tree (duniverse) exports.
pin-depends: [
 ["digestif.1.4.0"
  "git+https://github.com/reuna-labs/digestif.git#770f9c355bd5fd60ebf63027b66a51920906519f"]
]
description: """
Selected Crypton PBKDF2-HMAC-SHA1/SHA256/SHA512 C kernels with small OCaml
bindings. Requires the coordinated Reuna Digestif C headers; no system crypto
library, RNG, Unix, Zarith or ctypes dependency.
"""
